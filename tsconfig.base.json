{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "declaration": true,
        "sourceMap": true,
        "checkJs": true,
        "allowJs": true,
        "strict": true,
        "alwaysStrict": true,
        "skipLibCheck": true,
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "exactOptionalPropertyTypes": true,
        "strictPropertyInitialization": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "esModuleInterop": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "typeRoots": [
            "node_modules/@types",
            "src/types/**/*",
        ],
    },
}